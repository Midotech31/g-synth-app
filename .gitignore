# Logs
*.log
g-synth.log

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environment
.venv/
venv/
env/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Local database (SQLite demo mode) — never commit user data
*.db
*.db-journal
gsynth.db

# Streamlit secrets — never commit DATABASE_URL or credentials
.streamlit/secrets.toml

# Frontend
node_modules/
frontend/dist/
frontend/*.tsbuildinfo
db.sqlite3

# Local production smoke-test artefacts
django_app/prodcheck.sqlite3

# Coverage artefacts. Regenerated by every test run and machine-specific:
# committing one guarantees a conflict on the next run that touches it.
.coverage
.coverage.*
htmlcov/
coverage.xml

# Packaging artefacts. Regenerated by `pip install -e .` and `python -m build`,
# which the engine now supports — so they appear the moment anyone installs it.
*.egg-info/
*.egg
build/
dist/
