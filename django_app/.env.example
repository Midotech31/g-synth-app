# Copy to .env and edit. .env is git-ignored.

# ─── Django ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-with-django-manage-py-generate-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ───────────────────────────────────────────────────────────
# Default in dev: SQLite (db.sqlite3). Override with a Postgres URL:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# In prod, point at your Supabase session-pooler URL:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ─── CORS ───────────────────────────────────────────────────────────────
# React dev server(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
