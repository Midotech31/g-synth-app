# Copy to .env and edit. .env is git-ignored.
#
# .env is loaded by manage.py / wsgi.py / asgi.py *before* the settings
# module is chosen, so DJANGO_SETTINGS_MODULE below genuinely takes effect.
# Real environment variables always win over anything set here.

# ─── Django ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Optional in dev (falls back to a public development key).
# REQUIRED in prod — config.settings.prod refuses to boot without it, and
# refuses to boot *with* the public development key.
DJANGO_SECRET_KEY=

# ─── Database ───────────────────────────────────────────────────────────
# Optional in dev: omit to use a local SQLite file (db.sqlite3).
# REQUIRED in prod — without it a container would fall back to SQLite on an
# ephemeral disk and lose every account on each redeploy.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
#
# Supabase (use the "Session pooler" connection string):
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ─── CORS ───────────────────────────────────────────────────────────────
# Origins the React SPA is served from. REQUIRED in prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
